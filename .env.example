# Copy to .env and fill in real values before running in production.
# docker-compose.yml reads these automatically when a .env file is present.

# REQUIRED in production — generate with: openssl rand -hex 32
CRITERIAMETER_SECRET_KEY=dev-secret-key-change-in-production

# Set to "true" when deployed behind HTTPS
CRITERIAMETER_COOKIE_SECURE=false

# Comma-separated list of allowed frontend origins
CRITERIAMETER_ALLOWED_ORIGINS=http://localhost:3000

# Database (defaults to SQLite in the cm_data Docker volume)
# PostgreSQL example: postgresql://user:password@db:5432/criteriameter
CRITERIAMETER_DATABASE_URL=sqlite:////data/criteriameter.db

# Log level: debug | info | warning | error
CRITERIAMETER_LOG_LEVEL=info

# Default admin account seeded on first startup (change password after first login)
CRITERIAMETER_SEED_ADMIN_EMAIL=admin@admin.com
CRITERIAMETER_SEED_ADMIN_PASSWORD=admin123
CRITERIAMETER_SEED_ADMIN_ROLE=admin
